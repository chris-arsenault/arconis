{
  "name": "arconis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && pnpm build:relay && pnpm build:control && pnpm build:accounts && pnpm build:maintenance && pnpm build:signup-limit",
    "build:signup-limit": "esbuild src/accounts/signupLimitLambda.ts --bundle --minify --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist-relay/signup-limit/index.js",
    "build:accounts": "esbuild src/accounts/lambda.ts --bundle --minify --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist-relay/accounts/index.js",
    "build:maintenance": "esbuild src/accounts/maintenanceLambda.ts --bundle --minify --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist-relay/maintenance/index.js",
    "build:relay": "esbuild src/relay/server.ts --bundle --minify --platform=node --target=node24 --format=cjs --outfile=dist-relay/server.cjs",
    "build:control": "esbuild src/relay/lambda.ts --bundle --minify --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist-relay/control/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "@maxgraph/core": "0.25.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "amazon-cognito-identity-js": "6.3.16",
    "jose": "6.2.13",
    "lib0": "^0.2.114",
    "lucide": "^1.70.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.36.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ahara/standards": "github:chris-arsenault/ahara-standards",
    "@aws-sdk/client-auto-scaling": "^3.1164.0",
    "@aws-sdk/client-cloudwatch": "^3.1164.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^4.0.0",
    "ws": "^8.18.3"
  }
}
